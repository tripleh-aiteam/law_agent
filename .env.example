# Vercel AI Gateway (recommended) — provides unified access to all providers
# Get one at https://vercel.com/dashboard/ai-gateway
AI_GATEWAY_API_KEY=

# Optional: direct provider keys (fallback if not using AI Gateway)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Korean Supreme Court / law.go.kr Open API key (optional — for live citation verification)
# Apply at https://open.law.go.kr
LAW_GO_KR_API_KEY=

# Google AI Studio (Gemini) — text embeddings via text-embedding-004 (768-dim).
# Free tier: 1,500 requests/day. Get one at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

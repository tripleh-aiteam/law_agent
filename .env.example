# ─────────────────────────────────────────────────────────────────────────────
# Law Agent — environment variables
#
# At minimum you need ONE of:
#   - AI_GATEWAY_API_KEY  (recommended — proxies ALL providers via Vercel Pro)
#   - direct provider keys (ANTHROPIC_API_KEY / OPENAI_API_KEY / etc.)
#
# When the user picks a model in the UI, the agent looks for that provider's
# direct key first; if missing, it falls back to AI_GATEWAY_API_KEY.
# ─────────────────────────────────────────────────────────────────────────────


# ── Vercel AI Gateway ────────────────────────────────────────────────────────
# RECOMMENDED. One key, all providers. Uses your Vercel Pro AI credit pool.
# Get it at: https://vercel.com/dashboard/ai-gateway
AI_GATEWAY_API_KEY=


# ── Anthropic (Claude Opus 4.7 + Sonnet 4.6) ────────────────────────────────
# Optional — used as direct fallback when AI Gateway hits rate limits or fails.
# Get it at: https://console.anthropic.com/settings/keys
# Requires pre-paid credit on your Anthropic account (~$5 minimum).
ANTHROPIC_API_KEY=


# ── OpenAI (GPT-4o + GPT-4o mini) ────────────────────────────────────────────
# Optional — direct fallback.
# Get it at: https://platform.openai.com/api-keys
# Requires pre-paid credit on your OpenAI account (~$5 minimum).
OPENAI_API_KEY=


# ── Google AI Studio (Gemini 2.5 Pro + Flash) ───────────────────────────────
# Optional — direct fallback. ALSO used as the embedding provider's fallback
# alongside the AI Gateway when configured.
# Get it at: https://aistudio.google.com/apikey
# Free tier: 1,500 requests/day, no credit card required.
GOOGLE_GENERATIVE_AI_API_KEY=


# ── Groq (Llama 4 Scout) ─────────────────────────────────────────────────────
# Optional — used by some legacy paths (corpus ingest normalizer if you
# customize it). Not currently in the user-facing model selector but kept
# for future restoration.
# Get it at: https://console.groq.com/keys
# Free tier: 14,400 req/day on most models, no credit card.
GROQ_API_KEY=


# ── Korean Supreme Court Open API (법제처 OPEN API) ──────────────────────────
# Used by the citation verifier and the ingest pipeline.
# Apply at: https://open.law.go.kr
# Note: requires registering your server IP in the open.law.go.kr portal.
LAW_GO_KR_API_KEY=

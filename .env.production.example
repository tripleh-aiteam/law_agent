# Law Agent — on-prem environment template
#
#   cp .env.production.example .env
#   then fill in the values below.
#
# docker-compose reads `.env` from this directory automatically.
# NEVER commit the filled-in .env — it is gitignored.

# ─── Database ──────────────────────────────────────────────────────────
# POSTGRES_PASSWORD is REQUIRED — compose refuses to start without it.
# Generate one:  openssl rand -base64 32
POSTGRES_USER=lawagent
POSTGRES_PASSWORD=
POSTGRES_DB=lawagent

# ─── App ───────────────────────────────────────────────────────────────
# Port published on the host. On the firm server, consider binding to
# localhost only in docker-compose.yml and terminating TLS at Caddy.
APP_PORT=3000

# ─── LLM providers ─────────────────────────────────────────────────────
# At least ONE of these is required for the app to answer questions.
# Embeddings are LOCAL and need no key at all.
#
# GROQ is free and is the app's default model (Open GPT 120B), so setting
# only GROQ_API_KEY produces a fully working system at zero LLM cost.
# The paid providers give materially better Korean legal quality.
#
#   Anthropic  https://console.anthropic.com/settings/keys
#   OpenAI     https://platform.openai.com/api-keys
#   Google     https://aistudio.google.com/apikey
#   Groq       https://console.groq.com/keys
#   Manus      https://manus.im/settings/api

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
GROQ_API_KEY=
MANUS_API_KEY=

# ─── law.go.kr citation verification ───────────────────────────────────
# The OC code registered at https://open.law.go.kr
#
# IMPORTANT: law.go.kr allowlists by IP. The firm server's public IP must be
# registered against this key, or verification silently returns nothing.
# This endpoint was unreachable from Vercel's US egress IPs — running from a
# Korean server is what fixes it.
LAW_GO_KR_API_KEY=

# ─── NOT USED on-prem ──────────────────────────────────────────────────
# AI_GATEWAY_API_KEY is intentionally absent. Embeddings are local and all
# LLM calls go direct to their provider. Nothing routes through Vercel.
